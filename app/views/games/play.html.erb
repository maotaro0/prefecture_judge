<main class="game-page">
  <section class="game-container">
    <h1 class="game-title">都道府県ジャッジ</h1>

    <p class="game-description">
      正解だと思う3つの都道府県を選んでください。
    </p>

    <div class="hint-area">
     <p class="hint-text">
      <%= @current_hint[:text] %> → <%= @current_hint[:count] %> / 3
     </p>

      <%= link_to "次のヒント", request.path, class: "hint-button" %>
    </div>

    <%= form_with url: answer_game_path, method: :post, local: true do %>
      <div class="prefecture-list">
        <% @candidate_prefectures.each do |prefecture| %>
          <button
            class="prefecture-card"
            type="button"
            data-prefecture-id="<%= prefecture.id %>"
          >
            <%= prefecture.name %>
          </button>
        <% end %>
      </div>

      <input
        type="hidden"
        name="selected_prefecture_ids"
        id="selected-prefecture-ids"
        value=""
      >

      <button type="submit" class="answer-button" disabled>
        回答する
      </button>
    <% end %>
  </section>
</main>